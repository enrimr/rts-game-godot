[resource]
script = ExtResource("1_presa")
id = "presa_canario"
display_name = "Presa Canario"
description = "Herding dog bred at the Mill. Sent at an animal it fetches it and leads it home: sheep join your flock on the way, wild game settles near your base for the hunters — and every trip pays food for how far he brought the animal. A guard dog too: a quick bite when his post or his flock is threatened, though he never abandons a herding trip on his own."
