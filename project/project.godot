; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Calima: Flames of the Atlantic"
config/description="A real-time strategy game inspired by Age of Empires II."
run/main_scene="res://scenes/game/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/app/calima-fota.icon.180.png"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
GameManager="*res://scripts/core/game_manager.gd"
ResourceManager="*res://scripts/core/resource_manager.gd"
SelectionManager="*res://scripts/core/selection_manager.gd"
PopulationManager="*res://scripts/core/population_manager.gd"
AgeManager="*res://scripts/core/age_manager.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
GameSettings="*res://scripts/core/game_settings.gd"
MatchConfig="*res://scripts/core/match_config.gd"
TerrainManager="*res://scripts/core/terrain_manager.gd"
CivBonusManager="*res://scripts/core/civ_bonus_manager.gd"
TechManager="*res://scripts/core/tech_manager.gd"
SaveManager="*res://scripts/core/save_manager.gd"
WeatherManager="*res://scripts/core/weather_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

